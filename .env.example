# Gemini
GEMINI_API_KEY=
# Flash-Lite gets 200 free requests/day; plain gemini-3.5-flash only gets 20.
GEMINI_MODEL=gemini-3.5-flash-lite
# Posts per batched review request. An unusable reply defers every post in the batch, so
# raise this only if you are short on daily requests.
GEMINI_BATCH_SIZE=2

# Blogger
BLOGGER_BLOG_ID=

# Only needed in CI (e.g. GitHub Actions), where no local token.json is present.
# For local dev, `python -m src.main auth` uses client_secret.json + token.json instead.
BLOGGER_CLIENT_ID=
BLOGGER_CLIENT_SECRET=
BLOGGER_REFRESH_TOKEN=

BLOGGER_CLIENT_SECRET_FILE=client_secret.json
BLOGGER_TOKEN_FILE=token.json

# DRAFT or LIVE
DEFAULT_PUBLISH_STATUS=DRAFT
MIN_WORD_COUNT=1200
